# Environment Configuration for LangGraph Website Automation Pipeline

# Google Docs Dynamic Benchmark Rules (Live Sync)
# Provide a Google Doc link (view access for 'Anyone with the link' or service account):
# Default: Live reference rules doc (view-only access)
GOOGLE_DOC_RULES_URL=https://docs.google.com/document/d/1m4aU0MB1w2vxqA1PuCVPLLIktNMB7WLoJDT994fSpMQ/edit?usp=sharing

# Ollama LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=120

# Scraping Settings
MAX_PAGES_PER_SITE=3
REQUEST_TIMEOUT_SECONDS=15
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Anti-Hallucination Corroborator
EVIDENCE_SIMILARITY_THRESHOLD=0.60

# Email Delivery (SMTP)
# Set DRY_RUN_EMAIL=false when you are ready to send real emails via SMTP
DRY_RUN_EMAIL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=audit@agency.example.com
EMAIL_FROM_NAME=Digital Performance Audit Team
DUPLICATE_GUARD_COOLDOWN_DAYS=30

# Agency Branding
AGENCY_NAME=Aaditya Pandey Branding
AUDITOR_NAME=Automated Lead Intelligence Team
AUDITOR_CONTACT=support@apexdigital.example.com

# Optional Google Sheets & Google Drive Service Account Integration
GOOGLE_SERVICE_ACCOUNT_JSON= 
GOOGLE_SHEET_NAME=Website_Audit_Leads
